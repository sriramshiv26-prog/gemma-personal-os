# Gemma 4 Personal OS — Environment Configuration Template
# Copy this file to .env and configure for your environment

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

# Ollama host address
OLLAMA_HOST=http://localhost:11434

# Number of parallel inference tasks
OLLAMA_NUM_PARALLEL=2              # M1: 1-2, M2/M3: 2-4, GPU: 4-8

# GPU memory allocation (if using GPU)
OLLAMA_GPU=1                       # 1 = enabled, 0 = disabled
OLLAMA_GPU_MEMORY=24gb             # Adjust based on your VRAM

# Number of CPU threads
OLLAMA_NUM_THREADS=8               # Adjust based on your CPU cores

# ============================================================================
# MODEL SELECTION
# ============================================================================

# Expert reasoning model (complex tasks)
CREW_AI_LLM=gemma2:26b

# Fast response model (simple tasks)
CREW_AI_LLM_FAST=gemma2:2b

# Model complexity threshold (tokens)
COMPLEXITY_THRESHOLD=500           # Switch to 26B if >500 tokens

# ============================================================================
# ANYTHINGLLM (PRIVATE RAG) CONFIGURATION
# ============================================================================

# AnythingLLM host and API
ANYTHINGLLM_HOST=http://localhost:3001
ANYTHINGLLM_API_KEY=default        # Change if using authentication

# Vector database configuration
VECTOR_DB_TYPE=milvus              # Options: milvus, weaviate, pinecone
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=19530               # Milvus default

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# RAG retrieval
RAG_CHUNK_SIZE=1024                # Chunk size in tokens
RAG_CHUNK_OVERLAP=200              # Overlap between chunks
RAG_TOP_K=5                        # Number of chunks to retrieve

# ============================================================================
# EXTERNAL API CONFIGURATION
# ============================================================================

# Serper.dev (Web Search API)
SERPER_API_KEY=                    # Get from https://serper.dev
SERPER_ENABLED=true
SERPER_RATE_LIMIT=10/sec

# ============================================================================
# CREW AI ORCHESTRATION
# ============================================================================

# Agent configuration
CREW_AI_TIMEOUT=300                # Task timeout in seconds
CREW_AI_MAX_RETRIES=3              # Retry failed tasks
CREW_AI_MEMORY_ENABLED=true        # Enable agent memory

# Tool execution
TOOL_EXECUTION_SANDBOX=true        # Sandbox tool execution
ALLOW_CODE_EXECUTION=true          # Allow Python code execution
ALLOW_FILE_SYSTEM_ACCESS=true      # Allow file I/O

# ============================================================================
# PERSISTENCE & LOGGING
# ============================================================================

# Database configuration
DATABASE_TYPE=sqlite               # Options: sqlite, postgresql
DATABASE_URL=sqlite:///.gemma-os/gemma_os.db

# PostgreSQL (if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/gemma_os

# Audit logging
AUDIT_LOG_PATH=~/.gemma-os/audit.log
AUDIT_LOG_FORMAT=json              # Options: json, csv, plaintext
AUDIT_LOG_RETENTION_DAYS=90        # Keep logs for 90 days

# Result storage
RESULT_OUTPUT_DIR=~/.gemma-os/results
RESULT_FORMAT=markdown             # Options: markdown, json, html

# ============================================================================
# SKILL FRAMEWORK
# ============================================================================

# SKILL loading
SKILL_REPOSITORY=https://github.com/sriramshiv26-prog/gemma-personal-os/tree/main/skills
SKILL_CACHE_TTL=2592000            # 30 days in seconds
SKILL_AUTO_UPDATE=true             # Auto-update skills from repo

# Available SKILLs (examples)
# SKILL_ENABLED=security-auditing,compliance-mapping,architecture-review

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level
LOG_LEVEL=INFO                     # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Log output
LOG_FORMAT=json                    # Options: json, plaintext
LOG_FILE=~/.gemma-os/logs/app.log
LOG_FILE_MAX_SIZE=104857600        # 100MB in bytes

# Verbose output
VERBOSE=false                      # Enable verbose logging

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Context window
MAX_CONTEXT_LENGTH=4096            # Tokens (256K supported, but limited by RAM)

# Batch processing
BATCH_SIZE=32                      # For bulk operations
BATCH_TIMEOUT=300                  # Timeout for batch operations in seconds

# Caching
ENABLE_CACHE=true                  # Enable result caching
CACHE_TTL=86400                    # Cache time-to-live in seconds (1 day)
CACHE_DIR=~/.gemma-os/cache

# ============================================================================
# COMPLIANCE & SECURITY
# ============================================================================

# Data minimization
COLLECT_TELEMETRY=false            # No usage telemetry
EXPOSE_API_KEYS=false              # Never log API keys

# External API exposure
ALLOW_EXTERNAL_API=true            # Allow external APIs (Serper, etc.)
API_CALL_LOG_ENABLED=true          # Log external API calls

# Offline mode
OFFLINE_MODE=false                 # Force offline (no web search)

# ============================================================================
# PLATFORM-SPECIFIC
# ============================================================================

# macOS specific
# METAL_ACCELERATION=true           # Use Metal on Apple Silicon

# Linux specific
# CUDA_VISIBLE_DEVICES=0             # GPU device selection

# Windows WSL2 specific
# WSL_HOST=localhost                 # WSL2 localhost forwarding

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Test mode
TEST_MODE=false                    # Enable test mode

# Debug mode
DEBUG_MODE=false                   # Enable debug mode

# Mock external APIs (for testing)
MOCK_SERPER=false                  # Mock Serper API responses
MOCK_OLLAMA=false                  # Mock Ollama (use dummy responses)

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Distributed setup
DISTRIBUTED_MODE=false             # Enable distributed inference
REDIS_HOST=localhost               # Redis for distributed cache
REDIS_PORT=6379

# Custom tool paths
CUSTOM_TOOL_PATH=~/.gemma-os/tools # Custom tools directory

# Fine-tuning configuration
FINETUNING_ENABLED=false           # Enable fine-tuning (experimental)
FINETUNING_DATASET_PATH=~/.gemma-os/datasets

# ============================================================================
# NOTES
# ============================================================================

# - Copy this file: cp config/.env.example .env
# - Edit with your values: nano .env
# - Do NOT commit .env file to Git
# - Each line format: KEY=value (no quotes needed unless value contains spaces)
# - Comments: Lines starting with # are ignored
# - Paths: Use ~ for home directory, absolute paths recommended for production
